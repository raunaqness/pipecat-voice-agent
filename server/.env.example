# pipecat-quickstart - Environment Variables
# Copy this file to .env and fill in your API keys

# Daily (Transport)
DAILY_API_KEY=
# Optional: leave empty to create a new room
# DAILY_ROOM_URL=



# Cartesia (STT/TTS)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Deepgram (STT/TTS)
DEEPGRAM_API_KEY=


# OpenAI or OpenRouter (LLM)
# For OpenAI: use https://api.openai.com/v1 (default, can be omitted)
# For OpenRouter: use https://openrouter.io/api/v1
# Get API key from: https://openrouter.io/keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_BASE_URL=https://openrouter.io/api/v1

# Alpha Vantage (stock price tool-call demo)
# Get API key from: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

